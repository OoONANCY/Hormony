# Copy to backend/.env and fill in. Real environment variables override this file.

# Database (SQLite works out of the box; Postgres via docker compose)
HORMONY_DATABASE_URL=sqlite:///./hormony.db
# HORMONY_DATABASE_URL=postgresql+psycopg://hormony:hormony@localhost:5432/hormony

# LLM provider: demo | anthropic | openrouter
# Leave empty to pick automatically from the key you set (OpenRouter first, then Anthropic, else demo).
# /health and the first event of every analysis always say which one is running.
HORMONY_LLM=

# OpenRouter (e.g. NVIDIA Nemotron). Get a key at https://openrouter.ai/keys
OPENROUTER_API_KEY=
HORMONY_OPENROUTER_MODEL=nvidia/nemotron-3-super-120b-a12b:free

# Anthropic (or run `ant auth login` and set HORMONY_LLM=anthropic)
ANTHROPIC_API_KEY=
HORMONY_MODEL=claude-opus-5

# Demo controls
HORMONY_TODAY=2026-09-29
HORMONY_DEMO_REPLAY=0
